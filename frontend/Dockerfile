FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=
ARG VITE_ADSENSE_CLIENT_ID=
ARG VITE_ADSENSE_ENABLED=
ARG VITE_ADSENSE_MODE=manual
ARG VITE_ADSENSE_REQUIRE_CONSENT=true
ARG VITE_ADSENSE_SLOT_HEADER=
ARG VITE_ADSENSE_SLOT_WORKSPACE=
ARG VITE_ADSENSE_SLOT_MID=
ARG VITE_ADSENSE_SLOT_FOOTER=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ADSENSE_CLIENT_ID=$VITE_ADSENSE_CLIENT_ID
ENV VITE_ADSENSE_ENABLED=$VITE_ADSENSE_ENABLED
ENV VITE_ADSENSE_MODE=$VITE_ADSENSE_MODE
ENV VITE_ADSENSE_REQUIRE_CONSENT=$VITE_ADSENSE_REQUIRE_CONSENT
ENV VITE_ADSENSE_SLOT_HEADER=$VITE_ADSENSE_SLOT_HEADER
ENV VITE_ADSENSE_SLOT_WORKSPACE=$VITE_ADSENSE_SLOT_WORKSPACE
ENV VITE_ADSENSE_SLOT_MID=$VITE_ADSENSE_SLOT_MID
ENV VITE_ADSENSE_SLOT_FOOTER=$VITE_ADSENSE_SLOT_FOOTER
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
