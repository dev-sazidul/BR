# Copy to frontend/.env for local development. Every value is optional.

# SQLite file, relative to frontend/. Create it with: npm run db:migrate
DATABASE_URL=file:./data/solva.db

# The internal background remover (remover/background_remover.py).
REMOVER_URL=http://127.0.0.1:8001
# REMOVER_TOKEN=

# Used in password reset links. Without SMTP_HOST, development prints the
# reset email to this terminal instead of sending it.
SITE_URL=http://127.0.0.1:5173
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Solva <noreply@example.com>

# No proxy in front of `next dev`. Set DISABLE_RATE_LIMITS=true while testing.
TRUSTED_PROXY_COUNT=1
# DISABLE_RATE_LIMITS=false

# Public AdSense publisher ID. The value below is a shape example, not an ID.
# Replace it with the ca-pub value from your AdSense account after approval.
# The site does not load the AdSense script while this value is still the example.
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# true shows the placements. false hides every placement, including placeholders.
# Leave empty to show placeholders during local development and to stay off in a
# production build until a real publisher ID is present.
VITE_ADSENSE_ENABLED=

# manual uses the slot IDs below. auto loads only the AdSense script.
# Use one mode. Leave Auto ads off in the AdSense account when this is manual.
VITE_ADSENSE_MODE=manual

# true waits for the on-page choice before loading AdSense. That choice is not a
# certified consent-management platform.
VITE_ADSENSE_REQUIRE_CONSENT=true

# Ad unit slot IDs from AdSense. Leave empty until the units exist.
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_WORKSPACE=
VITE_ADSENSE_SLOT_MID=
VITE_ADSENSE_SLOT_FOOTER=
