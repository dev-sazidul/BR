# Copy to backend/.env for local overrides. Never commit the real file.
# Local development works without this file: SQLite, sync processing, rembg.

DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave POSTGRES_* unset to use SQLite.
# POSTGRES_DB=solva
# POSTGRES_USER=solva
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# rembg (local ONNX) or http (an operator-configured endpoint that returns an image).
AI_PROVIDER=rembg
REMBG_MODEL=u2net
# U2NET_HOME=/absolute/path/to/model-cache

# Only used when AI_PROVIDER=http. The endpoint must be a host you trust.
# AI_HTTP_ENDPOINT=https://example.com/remove
# AI_HTTP_API_KEY=
# AI_HTTP_TIMEOUT_SECONDS=60

MAX_UPLOAD_BYTES=10485760
MAX_DIMENSION_PX=4096
MAX_IMAGE_PIXELS=16000000
IMAGE_RETENTION_MINUTES=30
PROCESSING_TIMEOUT_SECONDS=120
BACKGROUND_REMOVAL_THROTTLE=10/minute

# Set true only behind a proxy you control. See README.
TRUST_PROXY_HEADERS=false
DJANGO_BEHIND_PROXY=false
DJANGO_SECURE_SSL_REDIRECT=false

# Optional. Shown on the contact page when set. Not a secret, but it is public.
CONTACT_EMAIL=

# Optional Celery cleanup schedule. The API also deletes expired files itself.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CLEANUP_INTERVAL_SECONDS=600
