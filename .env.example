# Used by Docker Compose. Copy to .env and replace every secret before deploying.
# The sample stack talks to the API over HTTP on localhost. Put HTTPS in front
# before exposing it, then set DJANGO_SECURE_SSL_REDIRECT=true.

DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost
DJANGO_BEHIND_PROXY=true
TRUST_PROXY_HEADERS=true
DJANGO_SECURE_SSL_REDIRECT=false

POSTGRES_DB=solva
POSTGRES_USER=solva
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CLEANUP_INTERVAL_SECONDS=600

AI_PROVIDER=rembg
REMBG_MODEL=u2net
MAX_UPLOAD_BYTES=10485760
MAX_DIMENSION_PX=4096
MAX_IMAGE_PIXELS=16000000
IMAGE_RETENTION_MINUTES=30
PROCESSING_TIMEOUT_SECONDS=120
BACKGROUND_REMOVAL_THROTTLE=10/minute
CONTACT_EMAIL=

# Optional accounts. Removal still works for guests.
# If the site and API are on different origins, add the site to DJANGO_CORS_ALLOWED_ORIGINS.
FRONTEND_ORIGIN=http://localhost
AUTH_THROTTLE=8/minute
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Solva <noreply@example.com>

# Leave empty so Docker's nginx serves the site and the API on one origin.
# The hosted frontend build uses frontend/.env.production.
VITE_API_BASE_URL=

# Public values baked into the frontend image at build time. The publisher value
# below is an example shape. Replace it after AdSense approval, then rebuild web.
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_ENABLED=
VITE_ADSENSE_MODE=manual
VITE_ADSENSE_REQUIRE_CONSENT=true
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_WORKSPACE=
VITE_ADSENSE_SLOT_MID=
VITE_ADSENSE_SLOT_FOOTER=
