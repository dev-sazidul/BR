# Used by Docker Compose. Copy to .env. Both services read this file.

# Public origin of the site. Used in password reset links and page metadata.
# Session cookies are marked Secure when this starts with https://.
SITE_URL=http://localhost:8080
# COOKIE_SECURE=true

# Optional second lock between web and remover. The remover is not reachable
# from outside the Compose network either way. Generate: openssl rand -hex 32
REMOVER_TOKEN=

# u2net (about 176 MB, better edges) or u2netp (about 4 MB, faster).
REMBG_MODEL=u2net
# Load the model when the remover starts instead of on the first upload.
REMOVER_PRELOAD=true

# Optional free stock-photo search for the editor. Keep the key server-side.
# Create a Pexels API key at https://www.pexels.com/api/.
PEXELS_API_KEY=
# Local per-IP protection for uncached searches; Pexels also enforces its own quota.
BACKGROUND_SEARCH_RATE=60/hour

MAX_UPLOAD_BYTES=10485760
MAX_DIMENSION_PX=4096
MAX_IMAGE_PIXELS=16000000
PROCESSING_TIMEOUT_SECONDS=120

BACKGROUND_REMOVAL_RATE=10/minute
AUTH_RATE=8/minute
# Reverse proxies in front of web that append to X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# Shown on the contact page when set. No mail is sent from that page.
CONTACT_EMAIL=

# Password reset email. Without SMTP_HOST the link is not delivered.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Solva <noreply@example.com>

# Public values baked into the web image at build time. The publisher value
# below is an example shape. Replace it after AdSense approval, then rebuild web.
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_ENABLED=
VITE_ADSENSE_MODE=manual
VITE_ADSENSE_REQUIRE_CONSENT=true
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_WORKSPACE=
VITE_ADSENSE_SLOT_MID=
VITE_ADSENSE_SLOT_FOOTER=
